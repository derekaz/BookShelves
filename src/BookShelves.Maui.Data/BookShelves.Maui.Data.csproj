<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
		<ApplicationVersion Condition="'$(ApplicationVersion)' == ''">999</ApplicationVersion>
		<PackageVersion Condition="'$(PackageVersion)' == ''">1.0.0</PackageVersion>
		<Version Condition="'$(Version)' == ''">1.0.0-local.1</Version>
		<VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
		<FileVersion Condition="'$(FileVersion)' == ''">1.0.0</FileVersion>
		<InformationalVersion Condition="'$(InformationalVersion)' == ''">1.0.0-local.1</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="ServiceInterfaces\**" />
		<EmbeddedResource Remove="ServiceInterfaces\**" />
		<None Remove="ServiceInterfaces\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Datasync.Client" Version="10.1.2" />
		<!--
			Use .Core (no bundled native SQLite library) so that the app project can
			provide the correct platform-specific provider. Using the full
			Microsoft.EntityFrameworkCore.Sqlite package would transitively pull in
			SQLitePCLRaw.bundle_e_sqlite3 whose module initialiser fires before Main()
			and crashes the iOS app when e_sqlite3 native library is not in the bundle.
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
		<!-- Force SQLitePCLRaw to the 3.x line to avoid transitive NU1903 from CommunityToolkit.Datasync.Client -> Microsoft.EntityFrameworkCore.Sqlite. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BookShelves.Shared\BookShelves.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Migrations\" />
	</ItemGroup>
</Project>
