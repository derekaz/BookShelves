<MudDialog>
    <TitleContent>Delete Book</TitleContent>
    <DialogContent>
        Are you sure you want to delete '@BookObject!.Title'?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Ok">Ok</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Close">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code 
{
    [CascadingParameter] 
    IMudDialogInstance? MudDialog { get; set; } // = default!;

    [Parameter]
    public BookViewModel? BookObject { get; set; }

    private void Ok() => MudDialog? .Close(DialogResult.Ok(BookObject?.IdValue));
    private void Close() => MudDialog?.Close(DialogResult.Cancel());
    private void Cancel() => MudDialog?.Cancel();
}