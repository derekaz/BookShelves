@inherits DeleteDialogBase<BookViewModel>

<MudDialog>
    <TitleContent>Delete Book</TitleContent>
    <DialogContent>
        Are you sure you want to delete '@GetRecordName(ModelObject!)'?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Ok">Ok</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Close">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    // 1. Tell the base class how to extract this entity's unique ID token
    protected override string GetRecordIdentifier(BookViewModel model) => model.Id ?? string.Empty;

    // 2. Tell the base class what property display text to inject into the modal string
    protected override string GetRecordName(BookViewModel model) => model.Title ?? string.Empty;
}