@code {
#if NET10_0
    [PersistentState]
#endif
    public IEnumerable<BookViewModel>? Books { get; set; }

    private string message = string.Empty;
    private string searchString = string.Empty;
    private SyncStatusViewModel syncStatus = new()
    {
        ShowWhenIdle = false,
        ShowProgress = true
    };
    private int currentStep;
    private int totalSteps = 3;
    private int progressPercentage;
    private BookShelves.Shared.Services.SyncStage syncStage = BookShelves.Shared.Services.SyncStage.None;
    private string syncMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SyncProgressService.ProgressChanged += OnSyncProgressChanged;
            Books ??= await DataService.GetBooksAsync();
        }
        catch (Microsoft.Identity.Client.MsalUiRequiredException)
        {
            // ConsentHandler.HandleConsentRequiredException(ex);
            // HandleMsalException(ex);
        }
        catch(NavigationException)
        {

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BookShelves.Shared.Components.Pages.Books.Index:OnInitializedAsync-Exception");
        }
    }

    private void OnSyncProgressChanged(object? sender, BookShelves.Shared.Services.SyncProgressEventArgs e)
    {
        try
        {
            currentStep = e.CurrentStep;
            totalSteps = e.TotalSteps;
            progressPercentage = e.ProgressPercentage;
            syncStage = e.SyncStage;
            syncMessage = BuildSyncMessage(e);
            syncStatus.CurrentStage = e.SyncStage;
            syncStatus.ProgressPercentage = e.ProgressPercentage;
            syncStatus.CurrentStep = e.CurrentStep;
            syncStatus.TotalSteps = e.TotalSteps;
            syncStatus.Message = syncMessage;

            if (e.SyncStage == BookShelves.Shared.Services.SyncStage.Completed)
            {
                _ = RefreshBooksAsync();
            }

            _ = InvokeAsync(StateHasChanged);
        }
        catch
        {
            // best-effort only
        }
    }

    private string BuildSyncMessage(BookShelves.Shared.Services.SyncProgressEventArgs? e)
    {
        if (e == null) return string.Empty;

        if (e.Current.HasValue && e.Total.HasValue && e.Total.Value > 0)
        {
            return $"{e.Message} ({e.Current}/{e.Total})";
        }

        return e.Message ?? string.Empty;
    }

    private async Task AddAsync()
    {
        var book = InitializeBookObject();
        await ShowDetailAsync(book, "New Book");
    }

    private async Task EditAsync(BookViewModel book)
    {
        await ShowDetailAsync(book, "Edit Book");
    }

    private async Task ShowDetailAsync(BookViewModel book, string titleText)
    {
        var parameters = new DialogParameters<BookDetail> { { x => x.BookObject, book }, { x => x.TitleText, titleText } };

        try
        {
            var options = new DialogOptions { BackgroundClass = "my-custom-class" };

            var dialog = await DialogService.ShowAsync<BookDetail>("Book Details", parameters, options);
            var result = await dialog.Result;
            if (result == null)
            {
                message = "Error completing the request";
            }
            else if (!result.Canceled)
            {
                message = result?.Data?.ToString() ?? string.Empty;
                Books = await DataService.GetBooksAsync() ?? [];
                QueueAutomaticSync();
            }
            else
            {
                message = String.IsNullOrEmpty(book.IdValue)
                    ? "Add canceled"
                    : "Edit canceled";
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BookShelves.Shared.Components.Pages.Books.Index:ShowDetailAsync-Exception");
        }
    }

    private async Task DeleteAsync(BookViewModel book)
    {
        var parameters = new DialogParameters<BookDelete> { { x => x.BookObject, book } };
        var dialog = await DialogService.ShowAsync<BookDelete>("Book Modal", parameters);
        var result = await dialog.Result;
        if (result == null)
        {
            message = "Error completing the request";
        }
        else if (!result.Canceled)
        {
            var deleteResult = await DataService.DeleteBookAsync(book);

            if (deleteResult)
            {
                message = $"'{book.Title}' deleted";
                Books = await DataService.GetBooksAsync() ?? [];
                QueueAutomaticSync();
            }
        }
        else
        {
            message = "Delete canceled";
        }

        await InvokeAsync(StateHasChanged);
    }

    private void QueueAutomaticSync()
    {
        if (!PageSyncCoordinator.IsSupported)
        {
            return;
        }

        _ = PageSyncCoordinator.QueueAutomaticSyncAsync(
            syncAction: () => SyncDataService.ServerSyncAsync(),
            refreshAction: () => RefreshBooksAsync(),
            setMessage: value =>
            {
                message = value;
            },
            refreshUi: () => InvokeAsync(StateHasChanged));
    }

    private async Task RefreshBooksAsync()
    {
        Books = await DataService.GetBooksAsync() ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private bool FilterFunc(BookViewModel book) 
    {
        return string.IsNullOrWhiteSpace(searchString) 
            || book.Title?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true 
            || book.Author?.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true 
            || book.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true;
    }

    private BookViewModel InitializeBookObject()
    {
        return new BookViewModel();
    }

    public void Dispose()
    {
        try { SyncProgressService.ProgressChanged -= OnSyncProgressChanged; } catch { }
    }
}
