@page "/books"
@inherits DataViewPageBase<BookViewModel>
@inject IBooksDataService DataService
@inject ILogger<Index> Logger
@attribute [Authorize(Roles = "Administrator")]


<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="3">
        @* Header bar with your reusable offline sync widget *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h4">Books</MudText>
            <MudSpacer />
            <SyncStatusPanel Status="@syncStatus" />
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">@message</MudAlert>
        }

        @* Responsive, searchable, sortable MudTable pointing to base class "Items" *@
        <MudTable Items="Items" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="500px" Breakpoint="Breakpoint.Sm" Class="subtle-sort-table" Loading="@(Items == null)" Filter="new Func<BookViewModel, bool>(FilterFunc)">
            <ToolBarContent>
                @* Hide the title text if the search input is actively expanded on mobile devices to preserve horizontal line space *@
                @if (!isSearchExpandedMobile)
                {
                    <MudText Typo="Typo.h6" Class="text-nowrap">Book Inventory</MudText>
                }
                <MudSpacer />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="w-100 justify-end">
                    @* --- DESKTOP VIEWPORT SCANNER --- *@
                    @* Displays the standard persistent soft gray box on larger monitors and tablet devices *@
                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="false">
                        <MudTextField @bind-Value="searchString"
                                      Placeholder="Search Inventory..."
                                      Variant="Variant.Filled"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium"
                                      Class="mt-0"
                                      Style="max-width: 300px;"
                                      Immediate="true"
                                      Clearable="true" />
                    </MudHidden>

                    @* --- MOBILE VIEWPORT SCANNER --- *@
                    @* Toggles smoothly between a single standalone icon button and an active full-width input field *@
                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                        @if (isSearchExpandedMobile)
                        {
                            <MudTextField @ref="mobileSearchField" 
                                          @bind-Value="searchString"
                                          Placeholder="Search..."
                                          Variant="Variant.Filled"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Class="mt-0 w-100 animate-fade-in"
                                          Immediate="true"
                                          Clearable="true"
                                          OnClearButtonClick="ToggleMobileSearchAsync"
                                          OnKeyDown="HandleSearchKeyDown" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Search"
                                           Color="Color.Inherit"
                                           OnClick="ToggleMobileSearchAsync"
                                           Title="Open Search Bar" />
                        }
                    </MudHidden>

                    @* --- ADD ACTION BUTTON --- *@
                    @* Stays pinned safely on the far right edge of the control bar header line *@
                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="false">
                        @* Desktop: Full button with text *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddAsync"
                                   Title="Add New Book"
                                   Class="text-nowrap">
                            Add
                        </MudButton>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                        @* Mobile: Perfect square icon button *@
                        <MudIconButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Icon="@Icons.Material.Filled.Add"
                                       OnClick="AddAsync"
                                       Title="Add New Book" />
                    </MudHidden>
                </MudStack>
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.Title)">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.Author?.Name)">Author</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.PublishDate)">Publish Date</MudTableSortLabel></MudTh>
                <MudTh>Description</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.LastUpdateTime)">Last Update</MudTableSortLabel></MudTh>
                <MudTh Style="text-align: right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Author">@context.Author?.Name</MudTd>
                <MudTd DataLabel="Publish Date">@context.PublishDate?.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Last Update">@context.LastUpdateTime</MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                        @* Edit Icon Button *@
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Title="Edit"
                                       OnClick="@(() => EditAsync(context))" />

                        @* Delete Icon Button *@
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Title="Delete"
                                       OnClick="@(() => DeleteAsync(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6" Align="Align.Center">No matching records found</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                        Try adjusting your search terms or verify your offline data sync status.
                    </MudText>
                </MudStack>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudStack>
</MudPaper>

<style>
</style>

@code {
    private readonly DialogOptions dialogOptions = new() { BackgroundClass = "mud-custom-blurred-background-class", CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool isSearchExpandedMobile = false;
    private MudTextField<string>? mobileSearchField;

    // 1. Tell the base component how to populate the dataset
    private async Task ToggleMobileSearchAsync()
    {
        isSearchExpandedMobile = !isSearchExpandedMobile;

        if (isSearchExpandedMobile)
        {
            // Gives Blazor one render tick to inject the MudTextField DOM node into the markup tree
            await Task.Yield();

            if (mobileSearchField is not null)
            {
                await mobileSearchField.FocusAsync();
            }
        }
        else
        {
            searchString = string.Empty;
        }
    }

    // 2. Intercepts the keyboard input and collapses the view if the user presses Escape
    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        // 1. ESC Key: Collapses the search layout entirely and resets the filter string
        if (e.Key == "Escape")
        {
            await ToggleMobileSearchAsync();
        }
        // 2. ENTER Key: Safely drops focus from the text box, dismissing the mobile virtual keyboard
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (mobileSearchField is not null)
            {
                await mobileSearchField.BlurAsync();
            }
        }
    }

    protected override async Task LoadDataServiceAsync() => Items = await DataService.GetBooksAsync();

    // 2. Define the explicit keyword search bounds for this view model context
    protected override bool ItemMatchesSearch(BookViewModel book, string query) =>
        (book.Title?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (book.Author?.Name?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (book.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false);

    private async Task AddAsync()
    {
        var parameters = new DialogParameters<BookDetail> { { x => x.ModelObject, new BookViewModel() }, { x => x.TitleText, "New Book" } };
        var dialog = await DialogService.ShowAsync<BookDetail>("Book Details", parameters, dialogOptions);

        // Harnessing your new safe base handler utility
        await ProcessDialogResultAsync(dialog, "Add canceled");
    }

    private async Task EditAsync(BookViewModel book)
    {
        var parameters = new DialogParameters<BookDetail> { { x => x.ModelObject, CloneBook(book) }, { x => x.TitleText, "Edit Book" } };
        var dialog = await DialogService.ShowAsync<BookDetail>("Book Details", parameters, dialogOptions);

        await ProcessDialogResultAsync(dialog, "Edit canceled");
    }

    private async Task DeleteAsync(BookViewModel book)
    {
        var parameters = new DialogParameters<BookDelete> { { x => x.ModelObject, book } };
        var options = new DialogOptions { BackgroundClass = "mud-custom-blurred-background-class", CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<BookDelete>("Delete Book", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            if (await DataService.DeleteBookAsync(book))
            {
                message = $"'{book.Title}' deleted";
                await FetchDataAsync();
                QueueAutomaticSync();
            }
        }
        else
        {
            message = "Delete canceled";
        }
    }

    private BookViewModel CloneBook(BookViewModel b) => new()
    {
        Id = b.Id,
        Title = b.Title,
        Description = b.Description,
        PublishDate = b.PublishDate,
        LastUpdateTime = b.LastUpdateTime,
        Author = b.Author == null ? null : new AuthorViewModel
        {
            Id = b.Author.Id,
            Name = b.Author.Name,
            Biography = b.Author.Biography,
            LastUpdateTime = b.Author.LastUpdateTime
        }
    };
}