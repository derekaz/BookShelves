@page "/books"
@implements IDisposable
@* @inject IBookFactory BookFactory *@
@inject IBooksDataService DataService
@inject ILogger<Index> Logger
@inject IDialogService DialogService
@inject ISyncDataService SyncDataService
@inject ISyncProgressService SyncProgressService
@attribute [Authorize(Roles = "Administrator")]

<h1>Books</h1>

<div class="mb-2">
    <button @onclick="AddAsync" class="btn btn-primary">Add Book</button>
</div>

<p>@message</p>

@if (Books == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">
                    <div class="fw-bold mb-1">Title</div>
                    <div class="text-muted mb-0">Author</div>
                    <div class="text-muted mb-0">Publish Date</div>
                </th>
                <th scope="col">
                    <div class="fw-bold mb-1">Description</div>
                </th>
                <th scope="col">Last Update</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Books)
            {
                <tr>
                    <th scope="row">@book.IdValue</th>
                    <td>
                        <div class="fw-normal mb-1">@book.Title</div>
                        <div class="text-muted mb-0">@book.Author?.Name</div>
                        <div class="text-muted mb-0">@book.PublishDate?.ToString("yyyy-MM-dd")</div>
                    </td>
                    <td>
                        <div class="fw-normal mb-1">@book.Description</div>
                    </td>
                    <td>@book.LastUpdateTime</td>
                    <td>
                        <input type="button" class="btn btn-primary" @onclick="(() => EditAsync(book))" value="Edit" />
                        <input type="button" class="btn btn-primary" @onclick="(() => DeleteAsync(book))" value="Delete" />
                    </td>
                </tr>
            }
        </tbody>
    </table>                       
}

<style>
    .my-custom-class {
        backdrop-filter: blur(10px);
    }
</style>

@code {
    #if NET10_0
    [PersistentState]
#endif
    public IEnumerable<BookViewModel>? Books { get; set; }

    private static readonly TimeSpan AutoSyncDelay = TimeSpan.FromSeconds(2);

    private readonly SemaphoreSlim syncOperationGate = new(1, 1);
    private CancellationTokenSource? autoSyncDelayCts;

    private string message = string.Empty;
    private bool isSyncing;
    private bool syncRequested;
    private int currentStep;
    private int totalSteps = 3;
    private int progressPercentage;
    private BookShelves.Shared.Services.SyncStage syncStage = BookShelves.Shared.Services.SyncStage.None;
    private string syncMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SyncProgressService.ProgressChanged += OnSyncProgressChanged;
            Books ??= await DataService.GetBooksAsync();
        }
        catch (Microsoft.Identity.Client.MsalUiRequiredException)
        {
            // ConsentHandler.HandleConsentRequiredException(ex);
            // HandleMsalException(ex);
        }
        catch(NavigationException)
        {

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BookShelves.Shared.Components.Pages.Books.Index:OnInitializedAsync-Exception");
        }
    }

    private bool IsSyncSupported()
    {
        return SyncDataService.SupportsSync;
    }

    private void OnSyncProgressChanged(object? sender, BookShelves.Shared.Services.SyncProgressEventArgs e)
    {
        try
        {
            currentStep = e.CurrentStep;
            totalSteps = e.TotalSteps;
            progressPercentage = e.ProgressPercentage;
            syncStage = e.SyncStage;
            syncMessage = BuildSyncMessage(e);
            isSyncing = e.SyncStage is BookShelves.Shared.Services.SyncStage.Started
                or BookShelves.Shared.Services.SyncStage.Pushing
                or BookShelves.Shared.Services.SyncStage.Pulling
                or BookShelves.Shared.Services.SyncStage.Processing;

            if (e.SyncStage == BookShelves.Shared.Services.SyncStage.Completed)
            {
                _ = RefreshBooksAsync();
            }

            _ = InvokeAsync(StateHasChanged);
        }
        catch
        {
            // best-effort only
        }
    }

    private string BuildSyncMessage(BookShelves.Shared.Services.SyncProgressEventArgs? e)
    {
        if (e == null) return string.Empty;

        if (e.Current.HasValue && e.Total.HasValue && e.Total.Value > 0)
        {
            return $"{e.Message} ({e.Current}/{e.Total})";
        }

        return e.Message ?? string.Empty;
    }

    private string GetStageDisplay(BookShelves.Shared.Services.SyncStage stage)
    {
        return stage switch
        {
            BookShelves.Shared.Services.SyncStage.Started => "Starting...",
            BookShelves.Shared.Services.SyncStage.Pushing => "📤 Uploading",
            BookShelves.Shared.Services.SyncStage.Pulling => "📥 Downloading",
            BookShelves.Shared.Services.SyncStage.Processing => "⚙️ Processing",
            BookShelves.Shared.Services.SyncStage.Completed => "✅ Complete",
            BookShelves.Shared.Services.SyncStage.Failed => "❌ Failed",
            _ => "Synchronizing..."
        };
    }

    private async Task AddAsync()
    {
        var book = InitializeBookObject();
        await ShowDetailAsync(book, "New Book");
    }

    private async Task EditAsync(BookViewModel book)
    {
        await ShowDetailAsync(book, "Edit Book");
    }

    private async Task ShowDetailAsync(BookViewModel book, string titleText)
    {
        var parameters = new DialogParameters<BookDetail> { { x => x.BookObject, book }, { x => x.TitleText, titleText } };

        try
        {
            var options = new DialogOptions { BackgroundClass = "my-custom-class" };

            var dialog = await DialogService.ShowAsync<BookDetail>("Book Details", parameters, options);
            var result = await dialog.Result;
            if (result == null)
            {
                message = "Error completing the request";
            }
            else if (!result.Canceled)
            {
                message = result?.Data?.ToString() ?? string.Empty;
                Books = await DataService.GetBooksAsync() ?? [];
                QueueAutomaticSync();
            }
            else
            {
                message = String.IsNullOrEmpty(book.IdValue)
                    ? "Add canceled"
                    : "Edit canceled";
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BookShelves.Shared.Components.Pages.Books.Index:ShowDetailAsync-Exception");
        }
    }

    private async Task DeleteAsync(BookViewModel book)
    {
        var parameters = new DialogParameters<BookDelete> { { x => x.BookObject, book } };
        var dialog = await DialogService.ShowAsync<BookDelete>("Book Modal", parameters);
        var result = await dialog.Result;
        if (result == null)
        {
            message = "Error completing the request";
        }
        else if (!result.Canceled)
        {
            var deleteResult = await DataService.DeleteBookAsync(book);

            if (deleteResult)
            {
                message = $"'{book.Title}' deleted";
                Books = await DataService.GetBooksAsync() ?? [];
                QueueAutomaticSync();
            }
        }
        else
        {
            message = "Delete canceled";
        }

        await InvokeAsync(StateHasChanged);
    }

    private void QueueAutomaticSync()
    {
        if (!IsSyncSupported())
        {
            return;
        }

        syncRequested = true;
        SyncProgressService.ReportStage(BookShelves.Shared.Services.SyncStage.Pending, "Local changes detected. Waiting to sync...");

        autoSyncDelayCts?.Cancel();
        autoSyncDelayCts?.Dispose();
        autoSyncDelayCts = new CancellationTokenSource();
        var token = autoSyncDelayCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(AutoSyncDelay, token);
                await TriggerSyncAsync(isAutomaticTrigger: true);
            }
            catch (OperationCanceledException)
            {
                // ignore - a newer local change reset the delay
            }
        }, token);
    }

    private async Task TriggerSyncAsync(bool isAutomaticTrigger)
    {
        if (!IsSyncSupported())
        {
            return;
        }

        if (!await syncOperationGate.WaitAsync(0))
        {
            syncRequested = true;
            return;
        }

        try
        {
            do
            {
                syncRequested = false;
                message = isAutomaticTrigger
                    ? "Book changes detected. Running background sync..."
                    : "Starting sync...";

                await InvokeAsync(StateHasChanged);
                await SyncDataService.ServerSyncAsync();
                Books = await DataService.GetBooksAsync() ?? [];

                message = isAutomaticTrigger ? "Background sync complete." : "Sync complete";
                isAutomaticTrigger = true;
            }
            while (syncRequested);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BookShelves.Shared.Components.Pages.Books.Index:TriggerSyncAsync-Exception");
            message = $"Sync failed: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            syncOperationGate.Release();
        }
    }

    private async Task RefreshBooksAsync()
    {
        Books = await DataService.GetBooksAsync() ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private BookViewModel InitializeBookObject()
    {
        return new BookViewModel();
    }

    public void Dispose()
    {
        try { SyncProgressService.ProgressChanged -= OnSyncProgressChanged; } catch { }

        autoSyncDelayCts?.Cancel();
        autoSyncDelayCts?.Dispose();
        syncOperationGate.Dispose();
    }
}
