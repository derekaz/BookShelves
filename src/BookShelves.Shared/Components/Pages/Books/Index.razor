@* @code {
#if NET10_0
    [PersistentState]
#endif
    public IEnumerable<BookViewModel>? Books { get; set; }

    private string message = string.Empty;
    private string searchString = string.Empty;

    private readonly SyncStatusViewModel syncStatus = new()
    {
        ShowWhenIdle = false,
        ShowProgress = true
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SyncProgressService.ProgressChanged += OnSyncProgressChanged;
            Books ??= await DataService.GetBooksAsync();
        }
        catch (Microsoft.Identity.Client.MsalUiRequiredException)
        {
            // Identity handling workflows
        }
        catch (NavigationException)
        {
            // Blazor router intercept handling
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Page}:{Method}-Exception", nameof(Index), nameof(OnInitializedAsync));
        }
    }

    private void OnSyncProgressChanged(object? sender, BookShelves.Shared.Services.SyncProgressEventArgs e)
    {
        try
        {
            syncStatus.CurrentStage = e.SyncStage;
            syncStatus.ProgressPercentage = e.ProgressPercentage;
            syncStatus.CurrentStep = e.CurrentStep;
            syncStatus.TotalSteps = e.TotalSteps;
            syncStatus.Message = BuildSyncMessage(e);

            if (e.SyncStage == BookShelves.Shared.Services.SyncStage.Completed)
            {
                _ = RefreshBooksAsync();
            }

            _ = InvokeAsync(StateHasChanged);
        }
        catch
        {
            // best-effort synchronization catch pipeline
        }
    }

    private string BuildSyncMessage(BookShelves.Shared.Services.SyncProgressEventArgs? e)
    {
        if (e == null) return string.Empty;

        return e.Current.HasValue && e.Total.HasValue && e.Total.Value > 0
            ? $"{e.Message} ({e.Current}/{e.Total})"
            : e.Message ?? string.Empty;
    }

    private async Task AddAsync()
    {
        await ShowDetailAsync(new BookViewModel(), "New Book");
    }

    private async Task EditAsync(BookViewModel book)
    {
        // Safe Cloning Pattern: isolates modal data tracking parameters from the data grid state arrays
        var clonedBook = CloneBook(book);
        await ShowDetailAsync(clonedBook, "Edit Book");
    }

    private async Task ShowDetailAsync(BookViewModel book, string titleText)
    {
        var parameters = new DialogParameters<BookDetail> { { x => x.BookObject, book }, { x => x.TitleText, titleText } };

        try
        {
            var options = new DialogOptions { BackgroundClass = "my-custom-class", CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
            var dialog = await DialogService.ShowAsync<BookDetail>("Book Details", parameters, options);
            var result = await dialog.Result;

            if (result == null)
            {
                message = "Error completing the request";
            }
            else if (!result.Canceled)
            {
                message = result.Data?.ToString() ?? string.Empty;
                await RefreshBooksAsync();
                QueueAutomaticSync();
            }
            else
            {
                message = string.IsNullOrEmpty(book.Id) ? "Add canceled" : "Edit canceled";
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Page}:{Method}-Exception", nameof(Index), nameof(ShowDetailAsync));
        }
    }

    private async Task DeleteAsync(BookViewModel book)
    {
        var parameters = new DialogParameters<BookDelete> { { x => x.BookObject, book } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<BookDelete>("Book Modal", parameters, options);
        var result = await dialog.Result;

        if (result == null)
        {
            message = "Error completing the request";
        }
        else if (!result.Canceled)
        {
            if (await DataService.DeleteBookAsync(book))
            {
                message = $"'{book.Title}' deleted";
                await RefreshBooksAsync();
                QueueAutomaticSync();
            }
        }
        else
        {
            message = "Delete canceled";
        }

        await InvokeAsync(StateHasChanged);
    }

    private void QueueAutomaticSync()
    {
        if (!PageSyncCoordinator.IsSupported) return;

        _ = PageSyncCoordinator.QueueAutomaticSyncAsync(
            syncAction: () => SyncDataService.ServerSyncAsync(),
            refreshAction: () => RefreshBooksAsync(),
            setMessage: value => message = value,
            refreshUi: () => InvokeAsync(StateHasChanged));
    }

    private async Task RefreshBooksAsync()
    {
        Books = await DataService.GetBooksAsync() ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private bool FilterFunc(BookViewModel book)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;

        // Structured hierarchy search evaluations
        return (book.Title?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (book.Author?.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (book.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private BookViewModel CloneBook(BookViewModel source) => new()
    {
        Id = source.Id,
        Title = source.Title,
        Description = source.Description,
        PublishDate = source.PublishDate,
        LastUpdateTime = source.LastUpdateTime,
        Author = source.Author == null ? null : new AuthorViewModel
        {
            Id = source.Author.Id,
            Name = source.Author.Name,
            Biography = source.Author.Biography,
            LastUpdateTime = source.Author.LastUpdateTime
        }
    };

    public void Dispose()
    {
        try { SyncProgressService.ProgressChanged -= OnSyncProgressChanged; } catch { }
    }
} *@
