@page "/books"
@implements IDisposable
@inject IBooksDataService DataService
@inject ILogger<Index> Logger
@inject IDialogService DialogService
@inject ISyncDataService SyncDataService
@inject ISyncProgressService SyncProgressService
@inject IPageSyncCoordinator PageSyncCoordinator
@attribute [Authorize(Roles = "Administrator")]

<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="3">
        @* Header bar with your reusable offline sync widget *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h4">Books</MudText>
            <MudSpacer />
            <SyncStatusPanel Status="@syncStatus" />
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync" StartIcon="@Icons.Material.Filled.Add" Width="fit-content">
            Add Book
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">@message</MudAlert>
        }

        @* Responsive, searchable, and sortable MudTable *@
        <MudTable Items="Books" Dense="true" Hover="true" FixedHeader="true" Height="500px" Breakpoint="Breakpoint.Sm" Loading="@(Books == null)" Filter="new Func<BookViewModel, bool>(FilterFunc)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Book Inventory</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="Search Title, Author, or Description..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" Clearable="true" />
            </ToolBarContent>
            <HeaderContent>
                @* <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.IdValue)">Id</MudTableSortLabel></MudTh> *@
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.Title)">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.Author?.Name)">Author</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.PublishDate)">Publish Date</MudTableSortLabel></MudTh>
                <MudTh>Description</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.LastUpdateTime)">Last Update</MudTableSortLabel></MudTh>
                <MudTh Style="text-align: right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                @* <MudTd DataLabel="Id">@context.IdValue</MudTd> *@
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Author">@context.Author?.Name</MudTd>
                <MudTd DataLabel="Publish Date">@context.PublishDate?.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Last Update">@context.LastUpdateTime</MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditAsync(context))">Edit</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DeleteAsync(context))">Delete</MudButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudStack>
</MudPaper>

<style>
    .my-custom-class {
        backdrop-filter: blur(10px);
    }
</style>

