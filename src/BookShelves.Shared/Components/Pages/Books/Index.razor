@page "/books"
@inherits DataViewPageBase<BookViewModel>
@inject IBooksDataService DataService
@inject ILogger<Index> Logger
@attribute [Authorize(Roles = "Administrator")]


<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="3">
        @* Header bar with your reusable offline sync widget *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h4">Books</MudText>
            <MudSpacer />
            <SyncStatusPanel Status="@syncStatus" />
        </MudStack>

        @* <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync" StartIcon="@Icons.Material.Filled.Add" Width="fit-content">
            Add Book
        </MudButton> *@

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">@message</MudAlert>
        }

        @* Responsive, searchable, sortable MudTable pointing to base class "Items" *@
        <MudTable Items="Items" Dense="true" Hover="true" FixedHeader="true" Height="500px" Breakpoint="Breakpoint.Sm" Loading="@(Items == null)" Filter="new Func<BookViewModel, bool>(FilterFunc)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Book Inventory</MudText>
                <MudSpacer />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="5" Class="w-100 justify-end">
                    <MudTextField @bind-Value="searchString" Placeholder="Search Title, Author, or Description..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" Clearable="true" />

                    <MudSpacer/>
                    @* Secondary Material Variant button stacked neatly right after search inputs *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddAsync"
                               Title="Add New Book"
                               Class="text-nowrap">
                        @* The text hides on mobile viewports, instantly transforming this into a compact "+" icon button *@
                        <MudHidden Breakpoint="Breakpoint.Xs" Invert="false">
                            Add
                        </MudHidden>
                    </MudButton>
                </MudStack>
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.Title)">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.Author?.Name)">Author</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.PublishDate)">Publish Date</MudTableSortLabel></MudTh>
                <MudTh>Description</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BookViewModel, object?>(x => x.LastUpdateTime)">Last Update</MudTableSortLabel></MudTh>
                <MudTh Style="text-align: right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Author">@context.Author?.Name</MudTd>
                <MudTd DataLabel="Publish Date">@context.PublishDate?.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Last Update">@context.LastUpdateTime</MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                        @* Edit Icon Button *@
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Title="Edit"
                                       OnClick="@(() => EditAsync(context))" />

                        @* Delete Icon Button *@
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Title="Delete"
                                       OnClick="@(() => DeleteAsync(context))" />
                      @*   <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditAsync(context))">Edit</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DeleteAsync(context))">Delete</MudButton> *@
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudStack>
</MudPaper>

<style>
    .my-custom-class {
        backdrop-filter: blur(10px);
    }
</style>

@code {
    private readonly DialogOptions dialogOptions = new() { BackgroundClass = "my-custom-class", CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    // 1. Tell the base component how to populate the dataset
    protected override async Task LoadDataServiceAsync() => Items = await DataService.GetBooksAsync();

    // 2. Define the explicit keyword search bounds for this view model context
    protected override bool ItemMatchesSearch(BookViewModel book, string query) =>
        (book.Title?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (book.Author?.Name?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (book.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false);

    private async Task AddAsync()
    {
        var parameters = new DialogParameters<BookDetail> { { x => x.ModelObject, new BookViewModel() }, { x => x.TitleText, "New Book" } };
        var dialog = await DialogService.ShowAsync<BookDetail>("Book Details", parameters, dialogOptions);

        // Harnessing your new safe base handler utility
        await ProcessDialogResultAsync(dialog, "Add canceled");
    }

    private async Task EditAsync(BookViewModel book)
    {
        var parameters = new DialogParameters<BookDetail> { { x => x.ModelObject, CloneBook(book) }, { x => x.TitleText, "Edit Book" } };
        var dialog = await DialogService.ShowAsync<BookDetail>("Book Details", parameters, dialogOptions);

        await ProcessDialogResultAsync(dialog, "Edit canceled");
    }

    private async Task DeleteAsync(BookViewModel book)
    {
        var parameters = new DialogParameters<BookDelete> { { x => x.ModelObject, book } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<BookDelete>("Delete Book", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            if (await DataService.DeleteBookAsync(book))
            {
                message = $"'{book.Title}' deleted";
                await FetchDataAsync();
                QueueAutomaticSync();
            }
        }
        else
        {
            message = "Delete canceled";
        }
    }

    private BookViewModel CloneBook(BookViewModel b) => new()
    {
        Id = b.Id,
        Title = b.Title,
        Description = b.Description,
        PublishDate = b.PublishDate,
        LastUpdateTime = b.LastUpdateTime,
        Author = b.Author == null ? null : new AuthorViewModel
        {
            Id = b.Author.Id,
            Name = b.Author.Name,
            Biography = b.Author.Biography,
            LastUpdateTime = b.Author.LastUpdateTime
        }
    };
}












