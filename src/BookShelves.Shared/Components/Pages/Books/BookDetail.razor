@using BookShelves.Shared.Data.Interfaces
@inject IBooksDataService DataService
@inject IAuthorsDataService AuthorsDataService

<MudDialog>
    <TitleContent>@TitleText</TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Title"
                          @bind-Value="@BookObject!.Title"
                          Variant="Variant.Outlined" />

            <div>
                <MudAutocomplete T="AuthorViewModel"
                                 Label="Author"
                                 @bind-Value="SelectedAuthor"
                                 SearchFunc="SearchAuthors"
                                 ToStringFunc="@(author => author?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudTextField @bind-Value="NewAuthorName"
                                  Label="Add new author name"
                                  Variant="Variant.Outlined" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="AddAuthorInlineAsync"
                               Disabled="@IsAddingAuthor">
                        Add Author
                    </MudButton>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(AuthorStatusMessage))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@AuthorStatusMessage</MudText>
                }
            </div>

            <MudTextField Label="Description"
                          @bind-Value="@BookObject.Description"
                          Variant="Variant.Outlined"
                          Lines="3" />

            <MudDatePicker @bind-Date="BookObject.PublishDate"
                           Label="Published"
                           Placeholder="Select a date"
                           Editable="true"
                           DateFormat="MM/dd/yyyy"
                           Variant="Variant.Outlined"
                           Clearable="true" />

            <MudField Label="Last Update" Variant="Variant.Outlined">
                @BookObject.LastUpdateTime
            </MudField>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitForm">Submit</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Close">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code 
{
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; } // = default!;

    [Parameter]
    public BookViewModel? BookObject { get; set; }

    [Parameter]
    public string TitleText { get; set; } = "Books";

    string message = string.Empty;

    private List<AuthorViewModel> Authors { get; set; } = [];

    private AuthorViewModel? SelectedAuthor { get; set; }

    private string NewAuthorName { get; set; } = string.Empty;

    private bool IsAddingAuthor { get; set; }

    private string AuthorStatusMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        BookObject ??= new BookViewModel();

        Authors = (await AuthorsDataService.GetAuthorsAsync()).ToList();

        if (!string.IsNullOrWhiteSpace(BookObject.Author?.Id))
        {
            SelectedAuthor = Authors.FirstOrDefault(a => a.Id == BookObject.Author.Id);
        }

        if (SelectedAuthor is null && !string.IsNullOrWhiteSpace(BookObject.Author?.Name))
        {
            SelectedAuthor = Authors.FirstOrDefault(a => string.Equals(a.Name, BookObject.Author.Name, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task SubmitForm()
    {
        if (BookObject is null)
        {
            return;
        }

        ApplySelectedAuthor();

        if (string.IsNullOrEmpty(BookObject.IdValue) || BookObject.IdValue == "0")
        {
            var result = await DataService.CreateBookAsync(BookObject);
            if (result)
            {
                string message = $"'{BookObject.Title}' has been added.";
                MudDialog?.Close(DialogResult.Ok(message));
            }
        }
        else
        {
            var result = await DataService.UpdateBookAsync(BookObject);
            if (result)
            {
                string message = $"'{BookObject.Title}' has been updated.";
                MudDialog?.Close(DialogResult.Ok(message));
            }
        }
    }

    private void ApplySelectedAuthor()
    {
        if (BookObject is null)
        {
            return;
        }

        BookObject.Author = SelectedAuthor is null
            ? null
            : new AuthorViewModel
            {
                Id = SelectedAuthor.Id,
                Name = SelectedAuthor.Name,
                Biography = SelectedAuthor.Biography,
                LastUpdateTime = SelectedAuthor.LastUpdateTime
            };
    }

    private Task<IEnumerable<AuthorViewModel>> SearchAuthors(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || string.Equals(value, SelectedAuthor?.Name, StringComparison.OrdinalIgnoreCase))
        {
            return Task.FromResult<IEnumerable<AuthorViewModel>>(Authors);
        }

        var results = Authors.Where(author =>
            !string.IsNullOrWhiteSpace(author.Name) &&
            author.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(results);
    }

    private async Task AddAuthorInlineAsync()
    {
        var authorName = NewAuthorName.Trim();
        if (string.IsNullOrWhiteSpace(authorName))
        {
            return;
        }

        var existingAuthor = Authors.FirstOrDefault(a => string.Equals(a.Name, authorName, StringComparison.OrdinalIgnoreCase));
        if (existingAuthor is not null)
        {
            SelectedAuthor = existingAuthor;
            NewAuthorName = string.Empty;
            AuthorStatusMessage = $"'{authorName}' already exists and has been selected.";
            return;
        }

        IsAddingAuthor = true;
        AuthorStatusMessage = string.Empty;

        try
        {
            var result = await AuthorsDataService.CreateAuthorAsync(new AuthorViewModel { Name = authorName });
            if (!result)
            {
                AuthorStatusMessage = "Unable to add author.";
                return;
            }

            Authors = (await AuthorsDataService.GetAuthorsAsync()).ToList();
            SelectedAuthor = Authors.LastOrDefault(a => string.Equals(a.Name, authorName, StringComparison.OrdinalIgnoreCase));
            NewAuthorName = string.Empty;
            AuthorStatusMessage = $"'{authorName}' has been added and selected.";
        }
        finally
        {
            IsAddingAuthor = false;
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Cancel());
    private void Cancel() => MudDialog?.Cancel();
}
