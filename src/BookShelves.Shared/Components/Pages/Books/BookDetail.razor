@using BookShelves.Shared.Data.Interfaces
@inherits DetailDialogBase<BookDetail, BookViewModel>
@inject IBooksDataService DataService
@inject IAuthorsDataService AuthorsDataService

<MudDialog>
    <TitleContent>@TitleText</TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @* Map fields directly to base class "ModelObject" target *@
            <MudTextField Label="Title" @bind-Value="@ModelObject!.Title" Variant="Variant.Outlined" />

            <div>
                <MudAutocomplete T="AuthorViewModel" Label="Author" @bind-Value="SelectedAuthor" SearchFunc="SearchAuthors" ToStringFunc="@(author => author?.Name ?? string.Empty)" Variant="Variant.Outlined" Dense="true" Clearable="true" ResetValueOnEmptyText="true" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudTextField @bind-Value="NewAuthorName" Label="Add new author name" Variant="Variant.Outlined" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddAuthorInlineAsync" Disabled="@IsAddingAuthor">
                        Add Author
                    </MudButton>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(AuthorStatusMessage))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@AuthorStatusMessage</MudText>
                }
            </div>

            <MudTextField Label="Description" @bind-Value="@ModelObject.Description" Variant="Variant.Outlined" Lines="3" />
            <MudDatePicker @bind-Date="ModelObject.PublishDate" Label="Published" Placeholder="Select a date" Editable="true" DateFormat="MM/dd/yyyy" Variant="Variant.Outlined" Clearable="true" />
            <MudField Label="Last Update" Variant="Variant.Outlined">@ModelObject.LastUpdateTime</MudField>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitForm">Submit</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Close">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    private List<AuthorViewModel> Authors { get; set; } = new();
    private AuthorViewModel? SelectedAuthor { get; set; }
    private string NewAuthorName { get; set; } = string.Empty;
    private bool IsAddingAuthor { get; set; }
    private string AuthorStatusMessage { get; set; } = string.Empty;

    // 1. Tell the base component how to instantiate a fresh book view model context
    protected override BookViewModel InitializeModel() => new();

    // 2. Define the explicit ID evaluation rule boundaries
    protected override bool IsNewRecord(BookViewModel model) => string.IsNullOrEmpty(model.Id) || model.Id == "0";

    // 3. Mount individual Data Service strategy pipelines
    protected override async Task<bool> ExecuteCreateAsync(BookViewModel model) => await DataService.CreateBookAsync(model);
    protected override async Task<bool> ExecuteUpdateAsync(BookViewModel model) => await DataService.UpdateBookAsync(model);
    protected override string GetSuccessMessage(BookViewModel model, bool isNew) => isNew ? $"'{model.Title}' has been added." : $"'{model.Title}' has been updated.";

    // 4. Load your Author drops safely inside the initialized hook method
    protected override async Task OnFormInitializedAsync()
    {
        Authors = (await AuthorsDataService.GetAuthorsAsync()).ToList();

        if (!string.IsNullOrWhiteSpace(ModelObject!.Author?.Id))
        {
            SelectedAuthor = Authors.FirstOrDefault(a => a.Id == ModelObject.Author.Id);
        }

        if (SelectedAuthor is null && !string.IsNullOrWhiteSpace(ModelObject.Author?.Name))
        {
            SelectedAuthor = Authors.FirstOrDefault(a => string.Equals(a.Name, ModelObject.Author.Name, StringComparison.OrdinalIgnoreCase));
        }
    }

    // 5. Package up the active chosen lookup right before base data changes submit
    protected override Task OnBeforeSubmitAsync()
    {
        ModelObject!.Author = SelectedAuthor is null ? null : new AuthorViewModel
        {
            Id = SelectedAuthor.Id,
            Name = SelectedAuthor.Name,
            Biography = SelectedAuthor.Biography,
            LastUpdateTime = SelectedAuthor.LastUpdateTime
        };
        return Task.CompletedTask;
    }

    private Task<IEnumerable<AuthorViewModel>> SearchAuthors(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || string.Equals(value, SelectedAuthor?.Name, StringComparison.OrdinalIgnoreCase))
        {
            return Task.FromResult<IEnumerable<AuthorViewModel>>(Authors);
        }

        return Task.FromResult(Authors.Where(a => !string.IsNullOrWhiteSpace(a.Name) && a.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task AddAuthorInlineAsync()
    {
        var authorName = NewAuthorName.Trim();
        if (string.IsNullOrWhiteSpace(authorName)) return;

        var existingAuthor = Authors.FirstOrDefault(a => string.Equals(a.Name, authorName, StringComparison.OrdinalIgnoreCase));
        if (existingAuthor is not null)
        {
            SelectedAuthor = existingAuthor;
            NewAuthorName = string.Empty;
            AuthorStatusMessage = $"'{authorName}' already exists and has been selected.";
            return;
        }

        IsAddingAuthor = true;
        AuthorStatusMessage = string.Empty;

        try
        {
            if (await AuthorsDataService.CreateAuthorAsync(new AuthorViewModel { Name = authorName }))
            {
                Authors = (await AuthorsDataService.GetAuthorsAsync()).ToList();
                SelectedAuthor = Authors.LastOrDefault(a => string.Equals(a.Name, authorName, StringComparison.OrdinalIgnoreCase));
                NewAuthorName = string.Empty;
                AuthorStatusMessage = $"'{authorName}' has been added and selected.";
            }
            else AuthorStatusMessage = "Unable to add author.";
        }
        finally { IsAddingAuthor = false; }
    }
}
