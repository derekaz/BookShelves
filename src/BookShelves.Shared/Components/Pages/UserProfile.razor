@page "/profile"
@using Microsoft.AspNetCore.Authorization
@* @using Microsoft.Graph.Models *@
@using System.Security.Claims
@* @inject IGraphService GraphService *@
@inject ILogger<UserProfile> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h4">User Profile</MudText>

        @if (user == null)
        {
            <MudText Typo="Typo.body1"><em>Loading...</em></MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>Property</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>DisplayName</td>
                        <td>@(user.Identity?.Name ?? "N/A")</td>
                    </tr>
                    <tr>
                        <td>UserPrincipalName</td>
                        <td>@(user.Identity?.Name ?? "N/A")</td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudText Typo="Typo.h6">Claims from ClaimsIdentity</MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>Claim Type</th>
                        <th>Claim Value</th>
                        <th>Subject Name</th>
                        <th>Issuer Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Security.Claims.Claim claim in claims)
                    {
                        <tr>
                            <td>@claim.Type</td>
                            <td>@claim.Value</td>
                            <td>@(claim?.Subject?.Name ?? "UNK")</td>
                            <td>@(claim?.Issuer ?? "UNK")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudStack>
</MudPaper>

@code {
    ClaimsPrincipal? user;
    IEnumerable<Claim> claims = new List<Claim>();

    protected override async Task OnInitializedAsync()
    {
        // HelloLabel.Text = $"Hello, {user.DisplayName}!";

        try
        {
            // user = await GraphService.GetUserInfoAsync();
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            user = authState.User;
            claims = authState.User.Claims;


            Logger.LogInformation("Logged in: '" + (authState.User.Identity?.Name ?? "N/A") + "'");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BookShelves.Shared.Components.Pages.UserProfile:OnInitializedAsync-Exception");
        }
    }
}
