<!--<input type="button" class="btn btn-primary" @onclick="(() => SyncBooksAsync())" value="Sync" />-->

@if (OperatingSystem.IsMacCatalyst())
{
    <div class="mt-3">
        <button class="btn btn-primary" @onclick="RequestDocumentsFolderAccessAsync">Choose Documents/BookShelves Folder</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(folderAccessStatus))
    {
        <p class="mt-2">@folderAccessStatus</p>
    }
}

@code
{
    private string? folderAccessStatus;

    private async Task RequestDocumentsFolderAccessAsync()
    {
        var folderPath = await documentsFolderAccessService.RequestAccessAsync();
        folderAccessStatus = folderPath is null
            ? "No folder was selected."
            : $"Persistent access granted: {folderPath}";
    }

