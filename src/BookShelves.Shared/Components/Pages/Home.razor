@page "/"
@using BookShelves.Shared.Services.ServiceInterfaces
@inject IConfiguration configuration;
@inject IDocumentsFolderAccessService documentsFolderAccessService

<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h4">BookShelves</MudText>
        <MudText Typo="Typo.body1">Welcome to your book library! 0.2.4</MudText>
        <MudText Typo="Typo.body2">TestKey=@configuration["TestKey"]</MudText>
        <MudText Typo="Typo.body2">TestKey1=@configuration["settings:TestKey1"]</MudText>
        <MudText Typo="Typo.body2">TestKey2=@configuration["settings:TestKey2"]</MudText>

        @if (OperatingSystem.IsMacCatalyst())
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="RequestDocumentsFolderAccessAsync">
                Choose Documents/BookShelves Folder
            </MudButton>

            @if (!string.IsNullOrWhiteSpace(folderAccessStatus))
            {
                <MudText Typo="Typo.body2">@folderAccessStatus</MudText>
            }
        }
    </MudStack>
</MudPaper>

@code
{
    private string? folderAccessStatus;

    private async Task RequestDocumentsFolderAccessAsync()
    {
        var folderPath = await documentsFolderAccessService.RequestAccessAsync();
        folderAccessStatus = folderPath is null
            ? "No folder was selected."
            : $"Persistent access granted: {folderPath}";
    }
}
