@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminAccess")]

<PageTitle>Admin</PageTitle>

<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4">Admin Panel</MudText>
        <MudText Typo="Typo.body1">This page is only accessible to users with the AdminAccess policy.</MudText>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            <MudText Typo="Typo.h6">Welcome, Administrator!</MudText>
            <MudText Typo="Typo.body2">
                You have successfully accessed the admin panel. This demonstrates that authorization policies
                are working correctly across all platforms (Blazor Server, Blazor WASM, and MAUI).
            </MudText>
            <MudText Typo="Typo.body2">
                To configure users with admin access, you would typically use roles or claims in Azure Entra ID.
            </MudText>
        </MudAlert>

        <MudText Typo="Typo.h6">Admin Functions</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Text="User Management" />
            <MudListItem Text="System Configuration" />
            <MudListItem Text="Reports and Analytics" />
            <MudListItem Text="Security Settings" />
        </MudList>
    </MudStack>
</MudPaper>

@code {
    // This page requires the AdminAccess policy
    // Configure the policy in your Program.cs to check for specific roles or claims
}
