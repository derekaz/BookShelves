@inject IBookUserActionsDataService BookUserActionsDataService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>Add to To-Be-Read</TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Notes" @bind-Value="notes" Variant="Variant.Outlined" Lines="2" />
            <MudDatePicker @bind-Date="remindAt" Label="Remind me on" Placeholder="Select a date" Editable="true" DateFormat="MM/dd/yyyy" Variant="Variant.Outlined" Clearable="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="isSubmitting">
            @(isSubmitting ? "Saving..." : "Save")
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public string BookId { get; set; } = string.Empty;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private string? notes;
    private DateTime? remindAt;
    private bool isSubmitting;

    protected async Task SubmitAsync()
    {
        isSubmitting = true;
        try
        {
            var remindAtUtc = remindAt.HasValue ? (DateTimeOffset?)new DateTimeOffset(remindAt.Value, TimeSpan.Zero) : null;
            var action = BookUserActionViewModel.CreateToBeRead(BookId, UserId, startTimeUtc: DateTimeOffset.UtcNow, notes: notes, remindAtUtc: remindAtUtc);

            if (await BookUserActionsDataService.CreateBookUserActionAsync(action))
            {
                Snackbar.Add("Added to To-Be-Read.", Severity.Success);
                MudDialog?.Close(DialogResult.Ok("Added to To-Be-Read."));
            }
            else
            {
                Snackbar.Add("Unable to save action.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("An error occurred while saving.", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    protected void Cancel() => MudDialog?.Cancel();
}
