@using BookShelves.Shared.Data.Interfaces
@inject IAuthorsDataService DataService

<MudDialog>
    <TitleContent>@TitleText</TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Name"
                          @bind-Value="@AuthorObject!.Name"
                          Variant="Variant.Outlined" />

            <MudTextField Label="Biography"
                          @bind-Value="@AuthorObject.Biography"
                          Variant="Variant.Outlined"
                          Lines="4" />

            <MudField Label="Last Update" Variant="Variant.Outlined">
                @AuthorObject.LastUpdateTime
            </MudField>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitForm">Submit</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Close">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code 
{
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; } // = default!;

    [Parameter]
    public AuthorViewModel? AuthorObject { get; set; }

    [Parameter]
    public string TitleText { get; set; } = "Authors";

    string message = string.Empty;

    private async Task SubmitForm()
    {
        if (String.IsNullOrEmpty(AuthorObject!.IdValue) || AuthorObject!.IdValue == "0")
        {
            var result = await DataService.CreateAuthorAsync(AuthorObject);
            if (result)
            {
                string message = $"'{AuthorObject.Name}' has been added.";
                MudDialog?.Close(DialogResult.Ok(message));
            }
        }
        else
        {
            var result = await DataService.UpdateAuthorAsync(AuthorObject);
            if (result)
            {
                string message = $"'{AuthorObject.Name}' has been updated.";
                MudDialog?.Close(DialogResult.Ok(message));
            }
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Cancel());
    private void Cancel() => MudDialog?.Cancel();
}