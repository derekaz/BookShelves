@using BookShelves.Shared.Data.Interfaces
@inherits DetailDialogBase<AuthorDetail, AuthorViewModel>
@inject IAuthorsDataService AuthorsDataService

<MudDialog>
    <TitleContent>@TitleText</TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Author Name" @bind-Value="@ModelObject!.Name" Variant="Variant.Outlined" />
            <MudTextField Label="Biography" @bind-Value="@ModelObject.Biography" Variant="Variant.Outlined" Lines="4" />
            <MudField Label="Last Update" Variant="Variant.Outlined">@ModelObject.LastUpdateTime</MudField>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitForm">Submit</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Close">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    protected override AuthorViewModel InitializeModel() => new();
    protected override bool IsNewRecord(AuthorViewModel model) => string.IsNullOrEmpty(model.Id) || model.Id == "0";
    protected override async Task<bool> ExecuteCreateAsync(AuthorViewModel model) => await AuthorsDataService.CreateAuthorAsync(model);
    protected override async Task<bool> ExecuteUpdateAsync(AuthorViewModel model) => await AuthorsDataService.UpdateAuthorAsync(model);
    protected override string GetSuccessMessage(AuthorViewModel model, bool isNew) => isNew ? $"'{model.Name}' added successfully." : $"'{model.Name}' updated successfully.";
}