@inherits DeleteDialogBase<AuthorViewModel>

<MudDialog>
    <TitleContent>Delete Author</TitleContent>
    <DialogContent>
        Are you sure you want to delete '@GetRecordName(ModelObject!)'?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Ok">Ok</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Close">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    protected override string GetRecordIdentifier(AuthorViewModel model) => model.Id ?? string.Empty;
    protected override string GetRecordName(AuthorViewModel model) => model.Name ?? string.Empty;
}