@implements IDisposable
@using System.Security.Claims

@inject IAuthenticationUIProvider AuthenticationUIProvider
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

<AuthorizeView>
    <Authorized>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mud-width-full">
            <MudText Typo="Typo.body2" Class="text-truncate">Hello, @GetDisplayName(context.User)!</MudText>
            @switch (AuthenticationUIProvider.LogoutActionType)
            {
                case AuthenticationUIActionType.Link:
                    <MudLink Href="@AuthenticationUIProvider.GetLogoutUrl()" Underline="Underline.Hover">Logout</MudLink>
                    break;
                case AuthenticationUIActionType.AuthenticationServiceShim:
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="BeginLogoutUsingAuthenticationServiceShim" Size="Size.Small">Logout</MudButton>
                    break;
                case AuthenticationUIActionType.Form:
                    <form action="@AuthenticationUIProvider.GetLogoutUrl()" method="post" style="display: inline-block;">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Logout</MudButton>
                    </form>
                    break;
                case AuthenticationUIActionType.Code:
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LogoutAsync" Size="Size.Small">Logout</MudButton>
                    break;
                default:
                    break;
            }
        </MudStack>
    </Authorized>
    <NotAuthorized>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="mud-width-full">
            @switch (AuthenticationUIProvider.LoginActionType)
            {
                case AuthenticationUIActionType.Link:
                    <MudLink Href="@AuthenticationUIProvider.GetLoginUrl()" Underline="Underline.Hover">Login</MudLink>
                    break;
                case AuthenticationUIActionType.Code:
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoginAsync" Size="Size.Small">Login</MudButton>
                    break;
                default:
                    break;
            }
        </MudStack>
    </NotAuthorized>
</AuthorizeView>


@code{
    private IExternalAuthenticationStateProvider? authStateProvider { get; set; }
    private IAuthService? authService { get; set; }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name) && !name.Contains("@", StringComparison.Ordinal))
        {
            return name;
        }

        var givenName = user.FindFirst("given_name")?.Value;
        if (!string.IsNullOrWhiteSpace(givenName))
        {
            return givenName;
        }

        return !string.IsNullOrWhiteSpace(name) ? name : "User";
    }

    private async Task LoginAsync()
    {
        authStateProvider = ServiceProvider.GetService(typeof(AuthenticationStateProvider)) as IExternalAuthenticationStateProvider;
        if (authStateProvider is not null)
        {
            try
            {
                var authProvider = (IExternalAuthenticationStateProvider)authStateProvider;
                if (authProvider is not null)
                {
                    await authProvider.LogInAsync();

                    var state = await authStateProvider.GetAuthenticationStateAsync();
                    if (state.User.Identity?.IsAuthenticated == true)
                    {
                        Navigation.NavigateTo("/");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Login failed: {ex.Message}");
            }
        }
    }

    private async Task LogoutAsync()
    {
        authStateProvider = ServiceProvider.GetService(typeof(AuthenticationStateProvider)) as IExternalAuthenticationStateProvider;
        if (authStateProvider is not null)
        {
            var authProvider = (IExternalAuthenticationStateProvider)authStateProvider;
            if (authProvider is not null)
            {
                await authProvider.LogoutAsync();

                var state = await authStateProvider.GetAuthenticationStateAsync();
                if (state.User.Identity?.IsAuthenticated == true)
                {
                    Navigation.NavigateTo("/", forceLoad: true);
                }
            }
        }
    }

    private async Task BeginLogoutUsingAuthenticationServiceShim()
    {
        authService = ServiceProvider.GetService(typeof(IAuthService)) as IAuthService;
        if (authService is not null)
        {
            await authService.LogoutAsync();
        };
    }

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = Navigation.Uri;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
