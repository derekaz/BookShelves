@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.Medium"
                   CloseButton="true"
                   BackdropClick="false"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout Style="height: 100%; display: flex; flex-direction: column;">
    <MudAppBar Elevation="1"
               Style="padding-top: env(safe-area-inset-top); height: calc(var(--mud-appbar-height) + env(safe-area-inset-top));">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">BookShelves</MudText>
        <MudSpacer />
        <SyncStatusIndicator />
    </MudAppBar>

    <MudDrawer @bind-Open="@drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Style="flex: 1 1 auto; min-height: 0; padding-bottom: env(safe-area-inset-bottom);">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
