@using BookShelves.Shared.Data.Interfaces
@using BookShelves.Shared.Services
@using BookShelves.Shared.Services.ServiceInterfaces
@implements IDisposable
@inject IFormFactor FormFactor
@inject ISyncDataService SyncDataService
@inject ISyncProgressService SyncProgressService
@inject ILogger<NavMenu> Logger

<MudStack Spacing="1" Class="pa-4 mud-height-full" Justify="Justify.SpaceBetween">
    <MudStack Spacing="1">
        <MudNavMenu Rounded="true" Color="Color.Primary">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">User Profile</MudNavLink>
            <MudNavLink Href="/counter" Icon="@Icons.Material.Filled.Add">Counter</MudNavLink>

            <AuthorizeView Roles="Administrator">
                <MudNavLink Href="/books" Icon="@Icons.Material.Filled.MenuBook">Books</MudNavLink>
                <MudNavLink Href="/authors" Icon="@Icons.Material.Filled.People">Authors</MudNavLink>
            </AuthorizeView>

            <AuthorizeView Policy="Authenticated">
                <MudNavLink Href="/weather" Icon="@Icons.Material.Filled.List">Weather</MudNavLink>
                <MudNavLink Href="/my-books" Icon="@Icons.Material.Filled.Bookmarks">My Books</MudNavLink>
            </AuthorizeView>

            <MudNavLink Href="/testpage2" Icon="@Icons.Material.Filled.Science">TestPage2</MudNavLink>

            <AuthorizeView Policy="AdminAccess">
                <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin</MudNavLink>
            </AuthorizeView>

            <MudNavLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Icon="@Icons.Material.Filled.Info">About</MudNavLink>
        </MudNavMenu>
    </MudStack>

    <MudStack Spacing="2">
        @if (SyncDataService.SupportsSync)
        {
            <AuthorizeView Roles="Administrator">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="ManualSyncAsync"
                           Disabled="@isSyncing">
                    @(isSyncing ? "Syncing..." : "Sync now")
                </MudButton>
            </AuthorizeView>
        }

        <LoginDisplay />

        <MudPaper Elevation="0" Outlined="true" Class="pa-2 mud-width-full">
            <MudStack Spacing="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mud-text-medium-emphasis font-weight-bold">Platform</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-end text-nowrap">@platform</MudText>
                </MudStack>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mud-text-medium-emphasis font-weight-bold">Form factor</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-end text-nowrap">@factor</MudText>
                </MudStack>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mud-text-medium-emphasis font-weight-bold">Version</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-end text-nowrap">@displayVersion</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudStack>


@code {
    private bool isSyncing;

    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();
    private string version => FormFactor.GetVersion();
    private string displayVersion => GetDisplayVersion(version);

    protected override void OnInitialized()
    {
        SyncProgressService.ProgressChanged += OnSyncProgressChanged;
    }

    private void OnSyncProgressChanged(object? sender, SyncProgressEventArgs e)
    {
        isSyncing = e.SyncStage is SyncStage.Started
            or SyncStage.Pushing
            or SyncStage.Pulling
            or SyncStage.Processing;

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ManualSyncAsync()
    {
        if (isSyncing)
        {
            return;
        }

        try
        {
            await SyncDataService.ServerSyncAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BookShelves.Shared.Components.Layout.NavMenu:ManualSyncAsync-Exception");
        }
    }

    private static string GetDisplayVersion(string fullVersion)
    {
        if (string.IsNullOrWhiteSpace(fullVersion))
        {
            return fullVersion;
        }

        var metadataSeparatorIndex = fullVersion.IndexOf('+');
        if (metadataSeparatorIndex < 0)
        {
            return fullVersion;
        }

        var metadata = fullVersion[(metadataSeparatorIndex + 1)..];
        if (metadata.Length <= 7)
        {
            return fullVersion;
        }

        return $"{fullVersion[..metadataSeparatorIndex]}+{metadata[..7]}";
    }

    public void Dispose()
    {
        try { SyncProgressService.ProgressChanged -= OnSyncProgressChanged; } catch { }
    }
}
